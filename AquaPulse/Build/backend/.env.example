# AquaPulse Environment Configuration
APP_NAME="AquaPulse"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Target Geography
DEFAULT_REGION="Palghar"
DEFAULT_STATE="Maharashtra"
DEFAULT_LATITUDE=19.6967
DEFAULT_LONGITUDE=72.7655

# Ollama LLM Configuration
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_TIMEOUT_SECONDS=60

# Database Configuration
# Uses SQLite locally by default with zero configuration; change to PostgreSQL for production
# Example PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/aquapulse
DATABASE_URL="sqlite+aiosqlite:///./aquapulse.db"

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY="./chroma_data"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# Security & CORS
SECRET_KEY="aquapulse-dev-secret-key-change-in-production"
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

